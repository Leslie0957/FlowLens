# Copy to .env.local in the FlowLens repository root. Keep .env.local private.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_MODE=MOCK
MODEL_MAX_OUTPUT_TOKENS=2048

# LIVE is paid and explicitly approved. Keep MOCK by default in new checkouts.
FLOWLENS_LIVE_APPROVED=0
# Per-process ceiling: a positive integer, or "unlimited" for approved ongoing use.
# Per-turn tool/model/time limits remain active in unlimited mode.
FLOWLENS_LIVE_MAX_REQUESTS=3
FLOWLENS_LIVE_MAX_OUTPUT_TOKENS=1024

# M1 local application. APP_DB_PATH is relative to the FlowLens root.
APP_DB_PATH=data/flowlens.sqlite
APP_PORT=4173
MOCK_MODEL=1
DEMO_MODE=true

# Pipeline diagnosis only: separate from the shared paid LIVE budget above.
# These are ceilings, not required request/tool counts.
FLOWLENS_PIPELINE_DIAG_MAX_REQUESTS=100
FLOWLENS_PIPELINE_DIAG_MAX_TOOL_CALLS=200
FLOWLENS_PIPELINE_DIAG_TIMEOUT_MS=900000
FLOWLENS_PIPELINE_DIAG_MAX_STALL_ROUNDS=3
FLOWLENS_PIPELINE_DIAG_MAX_CONTEXT_BYTES=262144
# Optional isolated LIVE evaluation cap (still capped by standing authorization).
FLOWLENS_PIPELINE_EVAL_LIVE_MAX_REQUESTS=8
