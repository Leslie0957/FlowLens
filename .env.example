# Copy to .env.local in the FlowLens repository root. Keep .env.local private.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_MODE=MOCK
MODEL_MAX_OUTPUT_TOKENS=2048

# LIVE is a paid, explicitly gated M0/M2 operation. Keep MOCK by default.
FLOWLENS_LIVE_APPROVED=0
# Per-process LIVE ceiling; choose a positive request count up to 12.
FLOWLENS_LIVE_MAX_REQUESTS=3
FLOWLENS_LIVE_MAX_OUTPUT_TOKENS=1024

# M1 local application. APP_DB_PATH is relative to the FlowLens root.
APP_DB_PATH=data/flowlens.sqlite
APP_PORT=4173
MOCK_MODEL=1
DEMO_MODE=true
