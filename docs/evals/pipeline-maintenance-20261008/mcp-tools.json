      "name": "get_logs",
      "description": "按需读取执行日志。默认最近20条，按原始seq升序；has_more时用next_before_seq作before_seq继续向前翻页，可保持step/level筛选。空页正常；证据充分即可结束，无须读完。",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "before_seq": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "step": {
            "type": "string",
            "enum": [
              "query",
              "validate",
              "precheck",
              "verification"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "DEBUG",
              "INFO",
              "WARN",
              "ERROR"
            ]
          }
        },
        "additionalProperties": false
      }
    },
