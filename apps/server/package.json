{
  "name": "@flowlens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-local-runner.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --silent",
    "db:migrate": "node --env-file-if-exists=../../.env.local --import tsx src/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=../../.env.local --import tsx src/cli.ts seed"
  },
  "dependencies": {
    "@flowlens/contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.36.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
