    "vite": "8.3.1",
    "vue-tsc": "3.3.11",
    "typescript": "5.9.3",
    "@types/node": "24.5.2",
    "vitest": "3.2.4",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "eslint": "9.36.0",
